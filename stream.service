[Unit]
Description=SurfTrak MJPEG Video Stream
# Start after networking and hostapd are up so the hotspot IP is ready
After=network.target hostapd.service
Wants=hostapd.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 /home/pi/stream.py
# Restart automatically if the script crashes (e.g. camera not ready yet)
Restart=always
RestartSec=3
# Log stdout/stderr to the systemd journal (view with: journalctl -u stream -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
